<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SweetBox | Contact Us</title>
    <link rel="stylesheet" href="style.css">

    <style>
        :root {
            --peach: #e8a58c;
            --cream: #fff3d4;
            --ink: #231309;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eceff1;
            color: var(--ink);
            font-family: Arial, Helvetica, sans-serif;
        }

        .site {
            max-width: 100%;
            background: var(--cream);
            min-height: 100vh;
            box-shadow: 0 0 24px rgba(0, 0, 0, .12);
        }

        header {
            background: var(--peach);
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 14px 28px;
            padding: 14px 28px;
        }

        .brand {
            font-family: "Alfa Slab One", Georgia, serif;
            font-size: 28px;
            line-height: 1.15;
            color: var(--ink);
            text-decoration: none;
            max-width: 200px;
        }

        nav ul {
            list-style: none;
            display: flex;
            flex-wrap: wrap;
            gap: 8px 34px;
            margin: 0;
            padding: 0;
        }

        nav li {
            list-style: disc;
            margin-left: 18px;
        }

        nav a {
            font-size: 19px;
            letter-spacing: .5px;
            text-transform: uppercase;
            color: var(--ink);
            text-decoration: none;
            padding-bottom: 2px;
            border-bottom: 2px solid transparent;
        }

        nav a:hover,
        nav a:focus-visible {
            border-bottom-color: var(--ink);
        }

        main {
            padding: 0;
            text-align: center;
        }

        main img {
            width: 100%;
            height: 100%;
            display: block;
        }

        @media (max-width: 400px) {
            header {
                justify-content: center;
                text-align: center;
            }

            .brand {
                max-width: none;
            }

            nav ul {
                justify-content: center;
                gap: 6px 24px;
            }

            nav a {
                font-size: 16px;
            }
        }
    </style>
</head>

<body>

    <header class="navbar">
        <a href="Homepage.html" class="logo">Sweet<span>Box</span></a>
        <nav>
            <a href="Homepage.html">Home</a>
            <a href="AboutUs.html">About Us</a>
            <a href="Products.html">Products</a>
            <a class="active" href="ContactUs.html">Contact Us</a>
            <a href="signup.html">Sign Up</a>
            <a href="login.html">Login</a>
        </nav>
    </header>

    <img src="https://i.imgur.com/UrW3BU3.jpeg" alt="Contact Us" style="width: 100%; height: auto; display: block;">




</body>

</html>
