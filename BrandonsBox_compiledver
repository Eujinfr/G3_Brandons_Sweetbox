<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BrandonsBox</title>
<link rel="icon" type="image/x-icon" href="https://i.imgur.com/vPhWTw3.png">


<style>
:root {
  --peach:#e8a58c;
  --cream:#fff3d4;
  --ink:#231309;
  --brown:#8b451f;
  --orange:#f4a460;
  --dark:#3d1c14;
}

* { box-sizing:border-box; }
html { scroll-behavior:smooth; }

body {
  margin:0;
  background:#eceff1;
  color:var(--ink);
  font-family:Arial,Helvetica,sans-serif;
}

.site {
  min-height:100vh;
  background:var(--cream);
  display:flex;
  flex-direction:column;
}

.page { display:none; flex:1; }
.page.show { display:block; }
section[id] { scroll-margin-top:70px; }

/* NAVIGATION */
.navbar {
  position:sticky;
  top:0;
  z-index:100;
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  justify-content:space-between;
  gap:10px 24px;
  padding:14px 28px;
  background:var(--peach);
}

.logo {
  color:var(--ink);
  text-decoration:none;
  font-family:Georgia,serif;
  font-size:28px;
  font-weight:bold;
}

.logo span { color:var(--brown); }

.navbar nav {
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:8px 24px;
}

.navbar nav a {
  color:var(--ink);
  text-decoration:none;
  text-transform:uppercase;
  letter-spacing:.5px;
  padding-bottom:2px;
  border-bottom:2px solid transparent;
}

nav a.active {
  border-bottom-color:var(--ink);
  font-weight:bold;
}

nav a.hovered { opacity:.7; }

#menu-toggle {
  display:none;
  background:none;
  border:2px solid var(--ink);
  border-radius:6px;
  font-size:22px;
  padding:2px 10px;
  cursor:pointer;
}

/* SECTIONS */
.slide { min-height:calc(100vh - 64px); }

.page-banner {
  text-align:center;
  padding:54px 20px 34px;
}

.page-banner .eyebrow {
  font-size:13px;
  font-weight:bold;
  letter-spacing:2px;
}

.page-banner h1 {
  font-family:Georgia,serif;
  font-size:clamp(30px,5vw,44px);
  margin:10px 0;
}

.page-banner p { font-size:18px; }

.about-layout {
  max-width:1000px;
  margin:auto;
  padding:30px 28px 65px;
  display:grid;
  grid-template-columns:260px 1fr;
  gap:40px;
  align-items:start;
}

.about-art {
  background:var(--peach);
  border-radius:14px;
  padding:55px 18px;
  text-align:center;
  font-size:66px;
}

.about-art span {
  display:block;
  margin-top:12px;
  font-size:17px;
  font-weight:bold;
}

.about-layout h2 {
  font-family:Georgia,serif;
  margin-top:0;
}

.about-layout p { line-height:1.7; }
.offer-list { padding-left:22px; line-height:1.9; }

.contact-image {
  width:100%;
  height:auto;
  display:block;
}

/* CONTACT DETAILS */
.contact-details {
  max-width:700px;
  margin:20px auto 60px;
  padding:35px;
  background:#fff3d4;
  border:2px solid #8b451f;
  border-radius:12px;
  text-align:center;
  line-height:1.8;
}

.contact-details h2 {
  font-family:Georgia,serif;
  color:#8b451f;
}

/* FOOTER */
footer {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
  padding:20px 28px;
  background:var(--peach);
}

footer p { margin:5px 0; }

/* TOAST MESSAGE */
#toast {
  position:fixed;
  bottom:24px;
  right:24px;
  background:#231309;
  color:#fff3d4;
  padding:12px 20px;
  border-radius:8px;
  opacity:0;
  transform:translateY(20px);
  transition:all .3s;
  pointer-events:none;
  z-index:999;
}

#toast.show {
  opacity:1;
  transform:translateY(0);
}

/* PRODUCT SECTION */
.section-title {
  text-align:center;
  padding-top:40px;
  margin:0;
}

.category-title {
  max-width:1000px;
  margin:30px auto 0;
  padding:0 28px;
  font-family:Georgia,serif;
}

/* PRODUCT GRID */
.product-grid {
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:20px;
  padding:20px 28px;
  max-width:1100px;
  margin:0 auto;
  align-items:stretch;
}

/* PRODUCT CARD */
.product-card {
  background:#fff3d4;
  border-radius:10px;
  padding:18px;
  text-align:center;
  border:1px solid #f0dfb0;
  display:flex;
  flex-direction:column;
  height:100%;
  transition:transform .2s,box-shadow .2s;
}

.product-card.hovered {
  transform:translateY(-6px);
  box-shadow:0 8px 18px rgba(0,0,0,.2);
}

/* PRODUCT PICTURE */
.product-image {
  display:block;
  width:100%;
  height:190px;
  object-fit:cover;
  object-position:center;
  border-radius:8px;
  margin:0 auto 14px;
  background:#f4e2c4;
}

/* INGREDIENTS */
.ingredients {
  text-align:left;
  font-size:13px;
  line-height:1.5;
  margin:8px 0 14px;
  color:#594333;
  flex-grow:1;
}

.ingredients strong {
  color:var(--brown);
}

.product-card h3 {
  margin:8px 0;
}

.product-card p.price {
  font-weight:bold;
  margin:8px 0 14px;
}

/* ALIGNED ADD TO CART BUTTONS */
.add-btn {
  background:var(--peach);
  border:none;
  padding:12px 16px;
  border-radius:6px;
  cursor:pointer;
  width:100%;
  min-height:44px;
  margin-top:auto;
  font-weight:bold;
  font-size:15px;
}

.add-btn:hover { background:#dc947b; }

.view-all-wrap {
  text-align:center;
  padding:10px 0 60px;
}

.view-all-btn {
  display:inline-block;
  background:var(--peach);
  padding:14px 28px;
  font-size:16px;
  font-weight:bold;
  text-transform:uppercase;
  letter-spacing:.5px;
  color:var(--ink);
  text-decoration:none;
  border-radius:6px;
}

.back-link {
  display:block;
  max-width:1000px;
  margin:24px auto 0;
  padding:0 28px;
  color:var(--ink);
}

#all-products-list { padding-bottom:40px; }

/* BROWN BUTTONS */
.brown-btn {
  display:inline-block;
  background:var(--brown);
  color:#fff;
  border:none;
  border-radius:30px;
  padding:14px 30px;
  font-family:Arial,sans-serif;
  font-size:15px;
  font-weight:bold;
  text-decoration:none;
  text-align:center;
  cursor:pointer;
}

.brown-btn:hover { opacity:.85; }

.qty-line {
  display:flex;
  align-items:center;
  gap:14px;
  margin-top:6px;
}

.qty-label {
  color:var(--orange);
  font-weight:bold;
  font-size:20px;
}

.qty-pill {
  display:inline-flex;
  align-items:center;
  gap:14px;
  background:#fff;
  border-radius:20px;
  padding:4px 12px;
  font-weight:bold;
}

.qty-btn {
  background:none;
  border:none;
  font-size:18px;
  font-weight:bold;
  cursor:pointer;
  padding:0 4px;
  color:var(--ink);
}

.item-img {
  display:flex;
  align-items:center;
  justify-content:center;
  background:var(--peach);
  border:2px solid var(--brown);
  border-radius:14px;
  overflow:hidden;
}

.item-img img {
  width:100%;
  height:100%;
  object-fit:cover;
}

/* CART PAGE */
.cart-page {
  max-width:900px;
  margin:30px auto;
  padding:30px 40px 40px;
  border:2px solid var(--brown);
  border-radius:22px;
}

.cart-page h1 {
  font-family:Arial,sans-serif;
  text-transform:uppercase;
  color:var(--brown);
  font-size:clamp(30px,5vw,44px);
  line-height:1.05;
  margin:0 0 30px;
  max-width:360px;
}

.cart-row {
  display:flex;
  align-items:center;
  gap:20px;
  padding:10px 0;
}

.cart-row .item-img {
  width:110px;
  height:110px;
  flex-shrink:0;
}

.cart-info { flex:1; }

.cart-name {
  font-family:Arial,sans-serif;
  font-size:clamp(20px,3vw,30px);
  margin:0;
}

.price-oval {
  background:#fff;
  color:var(--brown);
  border-radius:50%;
  padding:14px 22px;
  font-size:20px;
  white-space:nowrap;
}

.cart-buttons {
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:20px 30px;
  margin-top:40px;
}

#cart-empty {
  text-align:center;
  font-size:18px;
}

/* CHECKOUT */
.checkout-page {
  max-width:1100px;
  margin:20px auto;
  padding:20px 28px 40px;
}

.checkout-title {
  font-family:Arial,sans-serif;
  color:var(--dark);
  font-size:clamp(34px,6vw,60px);
  letter-spacing:-2px;
  margin:0 0 10px;
}

.checkout-layout {
  display:grid;
  grid-template-columns:1fr 340px;
  gap:30px;
  align-items:start;
}

.checkout-fields h3 {
  font-size:24px;
  font-weight:normal;
  margin:20px 0 6px;
}

.field-row {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:0 40px;
}

.field-row.three {
  grid-template-columns:1.4fr 1fr 1fr;
}

.checkout-fields label {
  display:block;
  margin-top:12px;
  font-size:18px;
}

.checkout-fields input,
.checkout-fields select {
  width:100%;
  padding:12px;
  margin-top:6px;
  border:2px solid #ccc;
  background:#fff;
  font-size:16px;
}

.checkout-fields input.invalid,
.checkout-fields select.invalid {
  border-color:#c0392b;
}

.error {
  display:block;
  color:#c0392b;
  font-size:13px;
  min-height:16px;
}

.orders-title {
  font-family:Arial,sans-serif;
  color:var(--dark);
  font-size:clamp(28px,4vw,48px);
  letter-spacing:-1px;
  text-align:center;
  margin:0 0 10px;
}

.orders-box {
  background:#fff;
  border-radius:30px;
  padding:24px 20px;
  min-height:250px;
}

.order-row {
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:22px;
}

.order-row .item-img {
  width:80px;
  height:80px;
  flex-shrink:0;
}

.order-name {
  font-weight:bold;
  font-size:14px;
  margin:0;
}

.order-info .qty-label { font-size:12px; }

.order-info .qty-pill {
  background:#deb887;
  padding:2px 10px;
  gap:10px;
}

.order-info .qty-btn { font-size:12px; }

.order-price {
  color:var(--brown);
  font-size:14px;
  margin:4px 0 0;
}

#pay-now {
  width:100%;
  margin-top:30px;
}

#checkout-message {
  max-width:600px;
  margin:14px auto 0;
}

/* SIGN UP AND LOGIN */
.form-box {
  max-width:420px;
  margin:30px auto;
  padding:24px;
  background:#fff3d4;
  border-radius:10px;
}

.form-box label {
  display:block;
  margin-top:14px;
  font-weight:bold;
}

.form-box input {
  width:100%;
  padding:10px;
  margin-top:4px;
  border:2px solid #ccc;
  border-radius:6px;
}

.form-box input.invalid { border-color:#c0392b; }

.form-box button {
  margin-top:18px;
  width:100%;
  padding:12px;
  background:#e8a58c;
  border:none;
  border-radius:6px;
  font-size:16px;
  cursor:pointer;
}

.form-message {
  margin-top:14px;
  padding:10px;
  border-radius:6px;
  text-align:center;
}

.form-message.success {
  background:#d4edda;
  color:#155724;
}

.form-message.error-msg {
  background:#f8d7da;
  color:#721c24;
}

/* RESPONSIVE DESIGN */
@media (max-width:800px) {
  .checkout-layout { grid-template-columns:1fr; }
  .field-row,
  .field-row.three { grid-template-columns:1fr; }
  .product-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
}

@media (max-width:700px) {
  .navbar { padding:14px 18px; }
  .about-layout { grid-template-columns:1fr; }
  .about-art {
    max-width:280px;
    width:100%;
    margin:0 auto;
  }
  footer {
    flex-direction:column;
    text-align:center;
  }
  .cart-page {
    padding:24px 18px 30px;
    margin:16px 12px;
  }
}

@media (max-width:600px) {
  #menu-toggle { display:block; }

  #main-nav {
    display:none;
    flex-direction:column;
    align-items:flex-start;
    width:100%;
  }

  #main-nav.open { display:flex; }

  .cart-row { flex-wrap:wrap; }
  .product-grid { grid-template-columns:1fr; }
}
</style>
</head>

<body>
<div class="site">

<header class="navbar">
  <a class="logo" href="#about">Brandons<span>Box</span></a>

  <button id="menu-toggle" type="button"
  aria-label="Toggle navigation" aria-expanded="false">☰</button>

  <nav id="main-nav">
    <a href="#about" data-page="about">About Us</a>
    <a href="#products" data-page="products">Products</a>
    <a href="#contact" data-page="contact">Contact Us</a>
    <a href="#signup" data-page="signup">Sign Up</a>
    <a href="#login" data-page="login">Login</a>
    <a href="#cart">🛒 Cart (<span id="cart-count">0</span>)</a>
  </nav>
</header>

<!-- MAIN WEBSITE -->
<div id="scroll-site">

  <!-- ABOUT -->
  <section class="slide" id="about">
    <div class="page-banner">
      <p class="eyebrow">GET TO KNOW US</p>
      <h1>About BrandonsBox</h1>
      <p>Sweet treats made for life's sweetest moments.</p>
    </div>

    <div class="about-layout">
      <div class="about-art">
        <img src="https://i.imgur.com/vPhWTw3.png" alt="BrandonsBox Logo" style="max-width: 100%; height: auto;">
        <br>
        <span>Box of Sweets and Happiness.</span>
      </div>

      <div>
        <h2>Every Sweet Treat Has a Story</h2>

        <p>
          At BrandonsBox: Box of Sweets and happiness, we believe that every
          sweet treat has the power to make an ordinary day a
          little more special. We are an online bakery and dessert
          store dedicated to creating delicious, freshly prepared
          treats that are perfect for celebrations, gifts, or simply
          satisfying your sweet cravings.
        </p>

        <p>
          From beautifully decorated cakes and freshly baked
          cookies to delicious pastries and irresistible brownies,
          BrandonsBox offers a variety of desserts made with care
          and attention to quality.
        </p>

        <h3>What We Offer</h3>

        <ul class="offer-list">
          <li>🎂 <strong>Cakes</strong> – Perfect for birthdays,
          celebrations, and special moments.</li>

          <li>🍪 <strong>Cookies</strong> – Freshly baked treats
          with delicious flavors and textures.</li>

          <li>🥐 <strong>Pastries</strong> – Delightful baked goods
          made for breakfast, snacks, or sharing.</li>

          <li>🍫 <strong>Brownies</strong> – Rich, fudgy, and
          delicious treats perfect for satisfying your chocolate
          cravings.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- BEST SELLERS -->
  <section class="slide" id="products">
    <h2 class="section-title">Best Sellers</h2>
    <div class="product-grid" id="best-sellers-list"></div>

    <div class="view-all-wrap">
      <a class="view-all-btn" href="#all-products">View All Products</a>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="slide" id="contact">
    <div class="page-banner">
      <p class="eyebrow">WE'D LOVE TO HEAR FROM YOU</p>
      <h1>Contact Us</h1>
      <p>Have questions? Get in touch with BrandonsBox!</p>
    </div>

    <div class="contact-details">
      <h2>Visit Our Bakery</h2>

      <p><strong>BrandonsBox Bakery</strong></p>

      <p>
        123 Sampaguita Street, Barangay Santo Niño,<br>
        Quezon City, Metro Manila, 1100, Philippines.
      </p>

      <p><strong>Business:</strong> Online Bakery and Dessert Store</p>
      <p><strong>Address:</strong> Quezon City, Philippines</p>
    </div>
  </section>
</div>

<!-- ALL PRODUCTS PAGE -->
<main class="page" id="page-all-products">
  <a class="back-link" href="#products">← Back</a>
  <h2 class="section-title">All Products</h2>
  <div id="all-products-list"></div>
</main>

<!-- CART PAGE -->
<main class="page" id="page-cart">
  <div class="cart-page">
    <h1>Shopping Cart</h1>
    <div id="cart-items"></div>

    <div class="cart-buttons">
      <a class="brown-btn" href="#products">Continue Shopping</a>
      <a class="brown-btn" id="proceed-btn" href="#checkout">
        Proceed to payment option
      </a>
    </div>
  </div>
</main>

<!-- CHECKOUT PAGE -->
<main class="page" id="page-checkout">
  <form class="checkout-page" id="checkout-form" novalidate>

    <div class="checkout-layout">

      <div class="checkout-fields">
        <h1 class="checkout-title">Checkout Page</h1>

        <h3>Basic Information:</h3>

        <div class="field-row">
          <div>
            <label for="checkout-first">First Name</label>
            <input type="text" id="checkout-first" placeholder="First Name">
            <span class="error" id="checkout-first-error"></span>
          </div>

          <div>
            <label for="checkout-last">Last Name</label>
            <input type="text" id="checkout-last" placeholder="Last Name">
            <span class="error" id="checkout-last-error"></span>
          </div>
        </div>

        <div class="field-row">
          <div>
            <label for="checkout-email">Email</label>
            <input type="email" id="checkout-email" placeholder="example@mail.com">
            <span class="error" id="checkout-email-error"></span>
          </div>

          <div>
            <label for="checkout-address">Address (IF DELIVERY)</label>
            <input type="text" id="checkout-address" placeholder="Your address">
          </div>
        </div>

        <h3>Payment Method</h3>

        <div class="field-row">
          <div>
            <select id="checkout-method">
              <option value="">Choose payment method</option>
              <option value="Gcash">Gcash</option>
              <option value="Maya">Maya</option>
              <option value="Apple Pay">Apple Pay</option>
              <option value="Cash on Delivery">Cash on Delivery</option>
            </select>
            <span class="error" id="checkout-method-error"></span>
          </div>
        </div>

        <h3>Payment Information:</h3>
        <p>For this website demo, do not enter real payment details.</p>

        <div class="field-row three">
          <div>
            <label for="checkout-card">Card Number (Demo)</label>
            <input type="text" id="checkout-card"
            inputmode="numeric" autocomplete="off"
            placeholder="XXXX XXXX XXXX XXXX" maxlength="19">
            <span class="error" id="checkout-card-error"></span>
          </div>

          <div>
            <label for="checkout-expiry">Expiry Date</label>
            <input type="text" id="checkout-expiry"
            inputmode="numeric" autocomplete="off"
            placeholder="mm/yy" maxlength="5">
            <span class="error" id="checkout-expiry-error"></span>
          </div>

          <div>
            <label for="checkout-cvc">CVC/CVV</label>
            <input type="password" id="checkout-cvc"
            inputmode="numeric" autocomplete="off"
            placeholder="XXX" maxlength="4">
            <span class="error" id="checkout-cvc-error"></span>
          </div>
        </div>
      </div>

      <div class="orders-wrap">
        <h2 class="orders-title">ORDERS</h2>
        <div class="orders-box" id="orders-items"></div>
      </div>

    </div>

    <button class="brown-btn" id="pay-now" type="submit">
      Confirm Demo Order
    </button>

    <div id="checkout-message"></div>
  </form>
</main>

<!-- SIGN UP PAGE -->
<main class="page" id="page-signup">
  <div class="form-box">
    <h2>Sign Up here</h2>

    <form id="signup-form" novalidate>
      <label for="signup-name">Full Name</label>
      <input type="text" id="signup-name" placeholder="Your full name">
      <span class="error" id="signup-name-error"></span>

      <label for="signup-email">Email</label>
      <input type="email" id="signup-email" placeholder="Your email">
      <span class="error" id="signup-email-error"></span>

      <label for="signup-password">Password</label>
      <input type="password" id="signup-password"
      data-min-length="8" placeholder="At least 8 characters">
      <span class="error" id="signup-password-error"></span>

      <label for="signup-confirm">Confirm Password</label>
      <input type="password" id="signup-confirm"
      data-match="signup-password" placeholder="Re-enter password">
      <span class="error" id="signup-confirm-error"></span>

      <button type="submit">Create Account</button>
      <div id="signup-message"></div>
    </form>

    <p style="text-align:center;">
      <a href="#login">Already have an account?</a>
    </p>
  </div>
</main>

<!-- LOGIN PAGE -->
<main class="page" id="page-login">
  <div class="form-box">
    <h2>Welcome back</h2>
    <p>Please log in</p>

    <form id="login-form" novalidate>
      <label for="login-email">Email</label>
      <input type="email" id="login-email" placeholder="Your email">
      <span class="error" id="login-email-error"></span>

      <label for="login-password">Password</label>
      <input type="password" id="login-password" placeholder="Your password">
      <span class="error" id="login-password-error"></span>

      <button type="submit">Log In</button>
      <div id="login-message"></div>
    </form>

