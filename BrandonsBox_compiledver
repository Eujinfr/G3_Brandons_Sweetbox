/* =====================================
   PAGE NAVIGATION
===================================== */

var SECTIONS = ["about","products","contact"];
var PAGES = ["all-products","cart","checkout","signup","login"];

function setActive(name) {
  document.querySelectorAll("nav a[data-page]").forEach(function(link) {
    link.classList.toggle("active",link.dataset.page === name);
  });
}

function showPage() {
  var name = window.location.hash.replace("#","").toLowerCase();
  var isPage = PAGES.indexOf(name) !== -1;

  document.getElementById("scroll-site").style.display =
    isPage ? "none" : "block";

  PAGES.forEach(function(p) {
    document.getElementById("page-" + p)
      .classList.toggle("show",p === name);
  });

  if (isPage) {
    setActive(name === "all-products" ? "products" : name);
    window.scrollTo(0,0);
  } else {
    if (SECTIONS.indexOf(name) === -1) name = "about";

    var target = document.getElementById(name);

    if (name === "about") {
      window.scrollTo(0,0);
    } else {
      target.scrollIntoView({
        behavior:"smooth",
        block:"start"
      });
    }

    setActive(name);
  }

  var nav = document.getElementById("main-nav");
  var btn = document.getElementById("menu-toggle");

  nav.classList.remove("open");
  btn.textContent = "☰";
  btn.setAttribute("aria-expanded","false");

  renderCart();
}

/* SCROLL SPY */
function setupScrollSpy() {
  if (!("IntersectionObserver" in window)) return;

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) setActive(entry.target.id);
    });
  }, {
    rootMargin:"-40% 0px -55% 0px"
  });

  SECTIONS.forEach(function(id) {
    observer.observe(document.getElementById(id));
  });
}

/* MOBILE MENU */
function setupMobileMenu() {
  var btn = document.getElementById("menu-toggle");
  var nav = document.getElementById("main-nav");

  btn.addEventListener("click",function() {
    nav.classList.toggle("open");

    var open = nav.classList.contains("open");

    btn.setAttribute("aria-expanded",open);
    btn.textContent = open ? "✕" : "☰";
  });
}

/* NAVIGATION HOVER */
function setupNavHover() {
  document.querySelectorAll("nav a").forEach(function(link) {
    link.addEventListener("mouseover",function() {
      link.classList.add("hovered");
    });

    link.addEventListener("mouseout",function() {
      link.classList.remove("hovered");
    });
  });
}

/* TOAST MESSAGE */
function showMessage(message) {
  var toast = document.getElementById("toast");

  if (!toast) {
    toast = document.createElement("div");
    toast.id = "toast";
    document.body.appendChild(toast);
  }

  toast.textContent = message;
  toast.classList.add("show");

  setTimeout(function() {
    toast.classList.remove("show");
  },2000);
}

/* =====================================
   STORAGE
===================================== */

function readStore(key) {
  try {
    return JSON.parse(localStorage.getItem(key));
  } catch(e) {
    return null;
  }
}

function writeStore(key,value) {
  try {
    localStorage.setItem(key,JSON.stringify(value));
  } catch(e) {}
}

/* =====================================
   FORM VALIDATION
===================================== */

function isValidEmail(email) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
}

function setError(input,message) {
  var box = document.getElementById(input.id + "-error");

  if (box) box.textContent = message;

  input.classList.toggle("invalid",message !== "");
}

function validateField(input) {
  var value = input.value.trim();

  if (value === "") {
    setError(input,"This field is required.");
    return false;
  }

  if (input.type === "email" && !isValidEmail(value)) {
    setError(input,"Please enter a valid email.");
    return false;
  }

  var min = parseInt(input.dataset.minLength);

  if (min && value.length < min) {
    setError(input,"Password must be at least " + min + " characters.");
    return false;
  }

  if (input.dataset.match) {
    if (value !== document.getElementById(input.dataset.match).value) {
      setError(input,"Passwords do not match.");
      return false;
    }
  }

  setError(input,"");
  return true;
}

function showFormMessage(boxId,text,isSuccess) {
  var box = document.getElementById(boxId);

  box.textContent = text;
  box.className = isSuccess
    ? "form-message success"
    : "form-message error-msg";
}

/* SIGN UP */
function setupSignupForm() {
  var form = document.getElementById("signup-form");
  var fields = form.querySelectorAll("input");

  fields.forEach(function(field) {
    field.addEventListener("input",function() {
      validateField(field);

      if (field.id === "signup-password") {
        var confirm = document.getElementById("signup-confirm");

        if (confirm.value !== "") validateField(confirm);
      }
    });
  });

  form.addEventListener("submit",function(event) {
    event.preventDefault();

    var allValid = true;

    fields.forEach(function(field) {
      if (!validateField(field)) allValid = false;
    });

    if (!allValid) {
      showFormMessage(
        "signup-message",
        "Please fix the errors above.",
        false
      );
      return;
    }

    var user = {
      name:document.getElementById("signup-name").value.trim(),
      email:document.getElementById("signup-email").value.trim().toLowerCase(),
      password:document.getElementById("signup-password").value
    };

    // Demonstration only; do not use this for real accounts.
    writeStore("BrandonsboxUser",user);

    showFormMessage(
      "signup-message",
      "Account created! Welcome to BrandonsBox, " + user.name + "!",
      true
    );

    form.reset();
  });
}

/* LOGIN */
function setupLoginForm() {
  var form = document.getElementById("login-form");
  var fields = form.querySelectorAll("input");

  fields.forEach(function(field) {
    field.addEventListener("input",function() {
      validateField(field);
    });
  });

  form.addEventListener("submit",function(event) {
    event.preventDefault();

    var allValid = true;

    fields.forEach(function(field) {
      if (!validateField(field)) allValid = false;
    });

    if (!allValid) {
      showFormMessage(
        "login-message",
        "Please fix the errors above.",
        false
      );
      return;
    }

    var saved = readStore("BrandonsboxUser");

    var email = document.getElementById("login-email")
      .value.trim().toLowerCase();

    var password = document.getElementById("login-password").value;

    if (saved && saved.email === email && saved.password === password) {
      writeStore("BrandonsboxLoggedIn",true);

      showFormMessage(
        "login-message",
        "Login successful! Welcome back, " + saved.name + "!",
        true
      );
    } else {
      showFormMessage(
        "login-message",
        "Incorrect email or password.",
        false
      );
    }
  });
}

/* =====================================
   SHOPPING CART
===================================== */

function getCart() {
  return readStore("BrandonsboxCart") || [];
}

function saveCart(cart) {
  writeStore("BrandonsboxCart",cart);
}

function calculateTotal(cart) {
  var total = 0;

  for (var i=0; i<cart.length; i++) {
    total += cart[i].price * cart[i].qty;
  }

  return total;
}

function updateCartCount() {
  var count = 0;

  getCart().forEach(function(item) {
    count += item.qty;
  });

  document.getElementById("cart-count").textContent = count;
}

/* QUANTITY BUTTONS */
function qtyPill(item) {
  return `
    <span class="qty-pill">
      <button type="button" class="qty-btn"
        data-id="${item.id}" data-delta="-1"
        aria-label="Decrease quantity">-</button>

      <span class="qty-value">${item.qty}</span>

      <button type="button" class="qty-btn"
        data-id="${item.id}" data-delta="1"
        aria-label="Increase quantity">+</button>
    </span>
  `;
}

/* CART IMAGE */
function cartImage(item) {
  var image = item.image ||
    "https://placehold.co/200x200/f4e2c4/8b451f?text=Food";

  return `
    <div class="item-img">
      <img src="${image}" alt="${escapeHTML(item.name)}"
      onerror="this.onerror=null;this.src='https://placehold.co/200x200/f4e2c4/8b451f?text=Food';">
    </div>
  `;
}

/* DISPLAY CART AND CHECKOUT ORDERS */
function renderCart() {
  var cartBox = document.getElementById("cart-items");
  var ordersBox = document.getElementById("orders-items");
  var cart = getCart();

  if (!cartBox || !ordersBox) return;

  if (cart.length === 0) {
    cartBox.innerHTML = '<p id="cart-empty">Your cart is empty.</p>';
    ordersBox.innerHTML = "<p>Your cart is empty.</p>";
    return;
  }

  var cartHtml = "";
  var ordersHtml = "";

  cart.forEach(function(item) {
    var lineTotal = "₱" + (item.price * item.qty).toFixed(2);

    cartHtml += `
      <div class="cart-row">
        ${cartImage(item)}

        <div class="cart-info">
          <h3 class="cart-name">${escapeHTML(item.name)}</h3>

          <div class="qty-line">
            <span class="qty-label">Quantity:</span>
            ${qtyPill(item)}
          </div>
        </div>

        <div class="price-oval">${lineTotal}</div>
      </div>
    `;

    ordersHtml += `
      <div class="order-row">
        ${cartImage(item)}

        <div class="order-info">
          <p class="order-name">${escapeHTML(item.name)}</p>

          <div class="qty-line">
            <span class="qty-label">Quantity:</span>
            ${qtyPill(item)}
          </div>

          <p class="order-price">${lineTotal}</p>
        </div>
      </div>
    `;
  });

  cartBox.innerHTML = cartHtml;
  ordersBox.innerHTML = ordersHtml;
}

/* ADD PRODUCT TO CART */
function addToCart(id) {
  var product = findProduct(id);

  if (!product) return;

  var cart = getCart();

  var existing = cart.find(function(item) {
    return item.id === id;
  });

  if (existing) {
    existing.qty += 1;
  } else {
    cart.push({
      id:product.id,
      name:product.name,
      price:product.price,
      image:product.image,
      qty:1
    });
  }

  saveCart(cart);
  renderCart();
  updateCartCount();

  showMessage(product.name + " added to cart!");
}

/* CHANGE QUANTITY */
function changeQty(id,delta) {
  var cart = getCart();

  cart.forEach(function(item) {
    if (item.id === id) item.qty += delta;
  });

  cart = cart.filter(function(item) {
    return item.qty > 0;
  });

  saveCart(cart);
  renderCart();
  updateCartCount();
}

/* PRODUCT BUTTON EVENTS */
function setupProducts() {
  renderCart();

  document.addEventListener("click",function(event) {
    if (event.target.classList.contains("add-btn")) {
      var card = event.target.closest(".product-card");

      if (card) addToCart(card.dataset.id);
    }

    if (event.target.classList.contains("qty-btn")) {
      changeQty(
        event.target.dataset.id,
        parseInt(event.target.dataset.delta)
      );
    }
  });

  document.addEventListener("mouseover",function(event) {
    var card = event.target.closest(".product-card");

    if (card) card.classList.add("hovered");
  });

  document.addEventListener("mouseout",function(event) {
    var card = event.target.closest(".product-card");

    if (card) card.classList.remove("hovered");
  });

  document.getElementById("proceed-btn")
    .addEventListener("click",function(event) {
      if (getCart().length === 0) {
        event.preventDefault();
        showMessage("Your cart is empty.");
      }
    });
}

/* =====================================
   CHECKOUT
===================================== */

function setupCheckoutForm() {
  var form = document.getElementById("checkout-form");

  var required = [
    "checkout-first",
    "checkout-last",
    "checkout-email"
  ].map(function(id) {
    return document.getElementById(id);
  });

  var method = document.getElementById("checkout-method");
  var card = document.getElementById("checkout-card");
  var expiry = document.getElementById("checkout-expiry");
  var cvc = document.getElementById("checkout-cvc");

  required.forEach(function(field) {
    field.addEventListener("input",function() {
      validateField(field);
    });
  });

  /* Format card number */
  card.addEventListener("input",function() {
    var digits = card.value.replace(/\D/g,"").slice(0,16);
    card.value = digits.replace(/(.{4})/g,"$1 ").trim();
  });

  /* Format expiry */
  expiry.addEventListener("input",function() {
    var digits = expiry.value.replace(/\D/g,"").slice(0,4);

    expiry.value = digits.length > 2
      ? digits.slice(0,2) + "/" + digits.slice(2)
      : digits;
  });

  /* Format CVC */
  cvc.addEventListener("input",function() {
    cvc.value = cvc.value.replace(/\D/g,"").slice(0,4);
  });

  function validateMethod() {
    var ok = method.value !== "";

    document.getElementById("checkout-method-error").textContent =
      ok ? "" : "Please choose a payment method.";

    method.classList.toggle("invalid",!ok);

    return ok;
  }

  method.addEventListener("change",validateMethod);

  function validateCardFields() {
    var anyFilled = card.value || expiry.value || cvc.value;

    if (!anyFilled) {
      [card,expiry,cvc].forEach(function(field) {
        setError(field,"");
      });

      return true;
    }

    var ok = true;

    if (card.value.replace(/\s/g,"").length !== 16) {
      setError(card,"Enter a 16-digit card number.");
      ok = false;
    } else {
      setError(card,"");
    }

    if (!/^(0[1-9]|1[0-2])\/\d{2}$/.test(expiry.value)) {
      setError(expiry,"Use mm/yy.");
      ok = false;
    } else {
      setError(expiry,"");
    }

    if (!/^\d{3,4}$/.test(cvc.value)) {
      setError(cvc,"Enter 3 or 4 digits.");
      ok = false;
    } else {
      setError(cvc,"");
    }

    return ok;
  }

  form.addEventListener("submit",function(event) {
    event.preventDefault();

    if (getCart().length === 0) {
      showFormMessage(
        "checkout-message",
        "Your cart is empty.",
        false
      );
      return;
    }

    var allValid = true;

    required.forEach(function(field) {
      if (!validateField(field)) allValid = false;
    });

    if (!validateMethod()) allValid = false;
    if (!validateCardFields()) allValid = false;

    if (!allValid) {
      showFormMessage(
        "checkout-message",
        "Please fix the errors above.",
        false
      );
      return;
    }

    var first = document.getElementById("checkout-first").value.trim();

    // Demo checkout only. No actual payment is processed.
    // Do not enter real card or payment information.
    saveCart([]);
    renderCart();
    updateCartCount();

    form.reset();

    showFormMessage(
      "checkout-message",
      "Demo order completed! Thank you, " + first + "!",
      true
    );
  });
}

/* =====================================
   START WEBSITE
===================================== */

document.addEventListener("DOMContentLoaded",function() {
  setupMobileMenu();
  setupNavHover();

  setupSignupForm();
  setupLoginForm();

  buildBestSellers();
  buildAllProducts();

  setupProducts();
  setupCheckoutForm();

  setupScrollSpy();
  updateCartCount();

  showPage();

  window.addEventListener("hashchange",showPage);
});

</script>
